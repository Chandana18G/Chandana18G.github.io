---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import GlanceCard from '@/components/GlanceCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NoteList from '@/components/NoteList.astro';
import ExperienceList from '@/components/ExperienceList.astro';
import { getFeaturedProjects, getNotes } from '@/lib/content';
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featured = await getFeaturedProjects();
const notes = (await getNotes()).slice(0, 3);
---

<BaseLayout scene={['sphere', 'orbit', 'helix']}>
  <Hero />

  <section class="container section intro">
    <GlanceCard />
  </section>

  <section class="container section" aria-labelledby="featured-title">
    <div class="section-head">
      <h2 id="featured-title">{t('home.featured')}</h2>
      <a href={localizePath('/projects/', lang)}>{t('home.allProjects')} →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container section" aria-labelledby="xp-title">
    <div class="section-head">
      <h2 id="xp-title">{t('home.experience')}</h2>
      <a href={localizePath('/about/', lang)}>Education & skills →</a>
    </div>
    <ExperienceList />
  </section>

  {notes.length > 0 && (
    <section class="container section" aria-labelledby="notes-title">
      <div class="section-head">
        <h2 id="notes-title">{t('home.notes')}</h2>
        <a href={localizePath('/notes/', lang)}>{t('home.allNotes')} →</a>
      </div>
      <NoteList notes={notes} emptyText={t('home.noNotes')} />
    </section>
  )}
</BaseLayout>

<style>
  .intro > :global(*) { max-width: 40rem; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-6);
    perspective: 1000px;
  }
</style>
