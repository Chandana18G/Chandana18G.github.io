---
import Object3D from './Object3D.astro';
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { profile, isSet } from '@/data/profile';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <p class="available"><span class="dot" aria-hidden="true"></span>{t('home.available')}</p>
    <h1 id="hero-title">
      {t('home.greeting')} <span class="name">{profile.shortName}.</span>
    </h1>
    <p class="role">{t('home.role')}</p>
    <p class="lede">{t('home.lede')}</p>
    <div class="ctas">
      <a class="btn btn--primary" href={localizePath('/projects/', lang)}>{t('home.cta.projects')} →</a>
      {isSet(profile.cv) && <a class="btn" href={profile.cv} download>{t('home.cta.cv')} ↓</a>}
      <a class="btn" href={localizePath('/contact/', lang)}>{t('home.cta.contact')}</a>
    </div>
    <ul class="quick-links">
      <li><a href={profile.github} rel="me">GitHub</a></li>
      {isSet(profile.linkedin) && <li><a href={profile.linkedin} rel="me">LinkedIn</a></li>}
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
  <Object3D variant="sphere" size="clamp(160px, 28vw, 320px)" class="hero-object" />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-12);
    padding-block: var(--space-16);
  }
  .copy > * { max-width: 40rem; }
  .available {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgb(94 234 212 / 0.35);
    border-radius: 999px;
    background: rgb(94 234 212 / 0.07);
    color: var(--mint);
    font: 500 0.82rem / 1.3 var(--font-mono);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 0 rgb(94 234 212 / 0.6);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    70% { box-shadow: 0 0 0 8px rgb(94 234 212 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(94 234 212 / 0); }
  }
  h1 { margin-top: var(--space-4); }
  .name {
    background: linear-gradient(90deg, var(--violet-bright), var(--neon), var(--magenta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 24px rgb(199 125 255 / 0.35));
  }
  .role {
    margin-top: var(--space-3);
    font: 600 var(--step-1) / 1.3 var(--font-display);
    color: var(--text);
  }
  .lede {
    margin-top: var(--space-4);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
    font: 500 var(--step--1) / 1.4 var(--font-mono);
  }
  .quick-links a { color: var(--text-muted); overflow-wrap: anywhere; }
  .quick-links a:hover { color: var(--violet-bright); }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-8);
    }
    .hero :global(.hero-object) { order: -1; justify-self: center; }
  }
</style>
