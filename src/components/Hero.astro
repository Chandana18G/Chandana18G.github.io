---
import Object3D from './Object3D.astro';
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { profile } from '@/data/profile';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1 id="hero-title">
      {t('home.greeting')} <span class="name">{profile.shortName}.</span>
    </h1>
    <p class="lede">{t('home.lede')}</p>
    <div class="ctas">
      <a class="btn btn--primary" href={localizePath('/projects/', lang)}>{t('home.cta.projects')} →</a>
      <a class="btn" href={localizePath('/contact/', lang)}>{t('home.cta.contact')}</a>
    </div>
  </div>
  <Object3D variant="sphere" size="clamp(160px, 30vw, 340px)" class="hero-object" />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-12);
    padding-block: var(--space-24) var(--space-16);
  }
  .copy > * { max-width: 38rem; }
  .copy > .lede { max-width: 34rem; }
  h1 { margin-top: var(--space-3); }
  .name {
    background: linear-gradient(90deg, var(--violet-bright), var(--neon), var(--magenta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 24px rgb(199 125 255 / 0.35));
  }
  .lede {
    margin-top: var(--space-6);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-12);
    }
    .hero :global(.hero-object) { order: -1; justify-self: center; }
  }
</style>
