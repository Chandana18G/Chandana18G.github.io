---
// Round portrait with a violet ring and glow. Source images: public/images/chandana-{320,640}.webp
// (regenerate from a new photo with sharp: square crop, 320 and 640 px, WebP quality ~82).
import { profile } from '@/data/profile';

interface Props {
  /** CSS size (width = height). */
  size?: string;
  /** true for the above-the-fold hero image: loads eagerly with high priority. */
  priority?: boolean;
  class?: string;
}

const { size = '240px', priority = false, class: className } = Astro.props;
---

<figure class:list={['portrait', className]} style={`--size: ${size}`}>
  <img
    src="/images/chandana-640.webp"
    srcset="/images/chandana-320.webp 320w, /images/chandana-640.webp 640w"
    sizes={size}
    width="640"
    height="640"
    alt={`Portrait of ${profile.name}`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

<style>
  .portrait {
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    margin: 0;
    flex: none;
    border-radius: 50%;
    padding: 4px;
    background: conic-gradient(from 210deg, var(--violet), var(--neon), var(--magenta), var(--violet-bright), var(--violet));
    box-shadow: 0 0 0 1px rgb(183 148 255 / 0.25), 0 0 60px rgb(139 92 246 / 0.35);
  }
  /* Soft halo behind the ring. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: -18%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(139 92 246 / 0.28), transparent 65%);
  }
  img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
  }
</style>
